:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #0f172a;
  background: #f8fafc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
html, body, #app { margin: 0; width: 100%; min-width: 320px; min-height: 100%; }
body { min-height: 100vh; }
button, input { font: inherit; }

.login-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: #fff;
}

.login-card {
  width: min(500px, 100%);
  background: #fff;
  padding: 24px 26px 28px;
}

.login-logo {
  display: block;
  width: min(350px, 88%);
  height: auto;
  margin: 0 auto 22px;
  object-fit: contain;
}

h1 {
  margin: 0 0 10px;
  font-size: clamp(30px, 5vw, 38px);
  line-height: 1.1;
}

label {
  display: grid;
  gap: 7px;
  margin-top: 17px;
  color: #64748b;
  font-size: 14px;
  font-weight: 800;
  text-transform: uppercase;
}

input {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 11px;
  padding: 12px 13px;
  color: #0f172a;
  background: #fff;
  font-size: 16px;
  text-transform: none;
  outline: none;
}

input:focus {
  border-color: #64748b;
  box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.12);
}

button {
  border: 0;
  border-radius: 10px;
  padding: 12px 14px;
  cursor: pointer;
  font-weight: 800;
}

button:disabled { cursor: wait; opacity: 0.7; }
.primary { width: 100%; margin-top: 18px; background: #0f172a; color: #fff; }
.error { color: #b91c1c; background: #fef2f2; padding: 10px 12px; border-radius: 10px; margin-top: 14px; }

.workspace {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #fff;
}

.tms-loading {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 14px;
  background: #fff;
  color: #64748b;
  font-weight: 700;
}

.tms-loading img {
  width: min(300px, 72vw);
  height: auto;
}

.tms-frame {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  background: #fff;
  opacity: 1;
  transition: opacity 120ms ease;
}

.tms-frame.is-loading {
  opacity: 0;
}

@media (max-width: 640px) {
  .login-shell { padding: 16px; }
  .login-card { padding: 18px 10px 24px; }
  .login-logo { width: min(320px, 92%); margin-bottom: 18px; }
}
